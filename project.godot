; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lunar Life"
config/description="Junior Astronaut Mission Trainer: train at the academy, run a lunar outpost and shelter the crew from a real NASA-recorded solar particle event."
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.039, 0.063, 0.125, 1)

[autoload]

UiKit="*res://scripts/autoload/ui_kit.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
ResourceSim="*res://scripts/autoload/resource_sim.gd"
Controls="*res://scripts/autoload/controls.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
Dialogue="*res://scripts/autoload/dialogue.gd"
MissionDirector="*res://scripts/autoload/mission_director.gd"
TaskLog="*res://scripts/autoload/task_log.gd"
PauseMenu="*res://scripts/autoload/pause_menu.gd"
Sfx="*res://scripts/autoload/sfx.gd"
MapManager="*res://scripts/autoload/map_manager.gd"
FieldNotes="*res://scripts/autoload/field_notes.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://assets/ui/lunar_theme.tres"
theme/custom_font="res://assets/fonts/Galmuri7-Latin.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
